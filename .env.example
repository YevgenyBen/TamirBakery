# Firebase web app config. Copy to .env.local and fill in.
# Get the values with: npx firebase-tools apps:sdkconfig web --project <project-id>
# These are public client identifiers, but they stay out of code so the app can
# move to the owner's Firebase project by changing env vars only (PLAN.md §4).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public site URL, used for SEO (canonical, sitemap, Open Graph). No domain yet.
SITE_URL=

# Order emails (PLAN.md "Domain and email"). Server-side only; never prefix with NEXT_PUBLIC_.
# Keep real values in .env.local and the hosting config, never in the repo.
RESEND_API_KEY=
# Until the domain is verified in Resend, use its test sender: onboarding@resend.dev
# (it only delivers to the Resend account owner's own address).
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# Contact email shown on the site (PLAN.md "Domain and email").
CONTACT_EMAIL=
