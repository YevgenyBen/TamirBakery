rules_version = '2';

// Locked down until the data model exists (PLAN.md checklist item 2).
// The Next.js server talks to Firestore through the Admin SDK, which bypasses
// these rules. Open specific paths here (e.g. public read of products) as
// features are built.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
